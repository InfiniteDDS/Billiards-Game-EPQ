import pymunk

# 1. Setup a basic space
space = pymunk.Space()

# Let's add a permanent target ball to the space so we have something to find
target_body = pymunk.Body(body_type=pymunk.Body.STATIC)
target_body.position = (100, 100)
target_shape = pymunk.Circle(target_body, 20)
space.add(target_body, target_shape)

# 2. Setup the temporary Query Shape (e.g., an explosion hitbox)
query_body = pymunk.Body(body_type=pymunk.Body.STATIC)
query_body.position = (90, 95)  # Positioned close to the target
query_shape = pymunk.Circle(query_body, 30) # Circle radius 30
# 3. Perform the query
# Note: You do NOT add query_shape to space.add()
hits = space.shape_query(query_shape)

# 4. Process the results
for hit in hits:
    collided_shape = hit.shape
    contact_points = hit.contact_point_set
    
    print(f"Hit detected on shape: {collided_shape}")
    print(f"Distance/Penetration depth: {contact_points.points[0].distance}")
